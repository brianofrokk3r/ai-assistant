{
  "name": "ai-assistant",
  "version": "1.1.1",
  "description": "Personal Discord bot that supports GitHub Copilot, OpenAI Codex, and OpenCode from a single codebase",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rubiss-Projects/ai-assistant.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "ai-assistant": "./dist/src/cli.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc && node scripts/copy-skills.mjs",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "register": "tsx scripts/register-commands.ts",
    "postinstall": "node patch-deps.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@github/copilot-sdk": "^1.0.14",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openai/codex-sdk": "^0.159.2",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.1",
    "discord.js": "^14.26.4",
    "dotenv": "^18.0.4",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^6.24.0"
  }
}
