# ─── Adapter selection and state ─────────────────────────────────────────────
# One network adapter per process: discord (default) or slack.
AI_ASSISTANT_ADAPTER=discord
# Persist journals/context/provider state outside the provider-readable workspace.
# Default: ~/.config/ai-assistant/adapters. Use an absolute path when overriding.
# Docker example (beside /data/workspaces, not inside it):
# AI_ASSISTANT_STATE_DIR=/data/adapter-state

# ─── Slack (opt-in; see README's Slack adapter section) ───────────────────────
# Set AI_ASSISTANT_ADAPTER=slack and keep AI_ASSISTANT_SECURITY_MODE=shared.
# Required for Slack: Socket Mode app token, installed bot token, workspace ID,
# and nonempty comma-separated channel/user ID allowlists. No Discord credentials.
# Configure app_mention events; invite the bot to every allowed channel.
# App token scope: connections:write.
# Bot scopes: app_mentions:read, chat:write, channels:read, channels:history.
# Private channels additionally need groups:read and groups:history.
# SLACK_APP_TOKEN=xapp-replace-me
# SLACK_BOT_TOKEN=xoxb-replace-me
# SLACK_TEAM_ID=T0123456789
# SLACK_ALLOWED_CHANNELS=C0123456789,C9876543210
# SLACK_ALLOWED_USERS=U0123456789,U9876543210
# Optional stable session namespace (default: default); keep across restarts.
# SLACK_INSTALLATION_ID=default
# Optional history credential; defaults to SLACK_BOT_TOKEN. Must be in the same
# workspace with channel/thread history access. A scoped user OAuth token can be
# used if the bot token cannot retrieve channel threads for this installation.
# SLACK_HISTORY_TOKEN=xoxp-replace-me
# Optional excluded history authors. IDs only, with NO spaces around commas.
# This does not restrict who may invoke the bot; SLACK_ALLOWED_USERS does that.
# SLACK_EXCLUDED_CONTEXT_USERS=U1111111111,U2222222222
# REQUIRED for Slack in Docker: skip the Discord registration entrypoint step.
# REGISTER_COMMANDS_ON_START=false

# ─── Provider ────────────────────────────────────────────────────────────────
# The AI backend to use. Options:
#   copilot  -> GitHub Copilot (auth via token or persisted CLI login) [default]
#   codex    -> OpenAI Codex (auth via OPENAI_API_KEY or Codex CLI login)
#   opencode -> OpenCode (auth via `opencode auth login`)
# This is the default provider. It can be switched per-session at runtime
# with /provider (no restart needed).
PROVIDER=copilot

# Optional GitHub contributions through two dedicated, repository-scoped Apps.
# Requires shared security mode. Never put private keys in the agent workspace.
AI_ASSISTANT_ENABLE_GITHUB_CONTRIBUTIONS=false
# granted: explicit github.contribute capability, contributor preset, or explicit bot admin.
# chat: everyone who already has chat.use access, plus explicit contribution grants.
GITHUB_CONTRIBUTIONS_ACCESS=granted
# Publish attempts per response. Default/unset/blank: 20; 0: unlimited.
# Non-negative safe integer; invalid values stop startup when enabled.
GITHUB_CONTRIBUTIONS_PUBLISH_LIMIT=20
# GITHUB_CONTRIBUTIONS_CONFIG_FILE=/data/.config/ai-assistant/github-apps/setup.json
# GITHUB_CONTRIBUTIONS_STATE_FILE=/data/.config/ai-assistant/github-contributions.json

# Human-authorized GitHub actions in Discord. Requires contributions and server reviews.
# Use a separate GitHub App with device flow + expiring user tokens, installed only
# on the contribution repositories. No App private key or client secret is needed.
AI_ASSISTANT_ENABLE_GITHUB_ACTIONS=false
# GITHUB_USER_APP_CLIENT_ID=Iv1.your_app_client_id
# GITHUB_ACTIONS_STATE_DIR=/data/.config/ai-assistant/github-actions
# Contributors may approve as themselves. Only explicit bot admins or rights grants
# for github.merge / github.release may merge or publish a release.

# Optional operator instructions applied to every provider. Inline text is
# convenient for Docker; a file is better for long, multiline prompts. When
# both are set, the file takes precedence. Container files should be under
# /data (the Docker-managed persistent volume).
# AI_ASSISTANT_SYSTEM_PROMPT="You are our friendly Discord community assistant."
# AI_ASSISTANT_SYSTEM_PROMPT_FILE=/data/system-prompt.txt

# ─── Discord ─────────────────────────────────────────────────────────────────
# Discord Application credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_APP_ID=your_application_id_here

# Guild (server) ID for development - commands register instantly to this guild
DISCORD_GUILD_ID=your_test_server_id_here

# Optional: comma-separated channel IDs where the bot responds to ALL messages (no @mention needed)
# Right-click a channel in Discord → Copy Channel ID (requires Developer Mode in Discord settings)
# Example: DISCORD_FREE_CHANNELS=123456789012345678,987654321098765432
DISCORD_FREE_CHANNELS=

# Bot-owned /chat thread participation: smart | always | mentions-only.
# Default when omitted: smart in shared mode, always in unrestricted mode.
# CHAT_PARTICIPATION_MODE=smart
# Default classifier uses the thread's provider login, separate from its chat model.
# Optional Jev evaluator: set jev and supply TYPESAFE_API_KEY below.
CHAT_PARTICIPATION_EVALUATOR=provider
# Defaults: gpt-5.6-luna (Codex/Copilot), available small model (OpenCode), jev-latest (Jev).
# Override with a small model available to your provider/account.
# CHAT_PARTICIPATION_MODEL=gpt-5.6-luna
# none | low. Copilot uses low because its SDK does not expose none.
CHAT_PARTICIPATION_REASONING=none
CHAT_PARTICIPATION_TIMEOUT_MS=15000
# TYPESAFE_API_KEY=your_typesafe_key

# Hide automatic link previews in the bot's text replies and scheduled messages.
# Links remain clickable. Restart the bot after changing this setting.
DISCORD_SUPPRESS_EMBEDS=false

# Optional: comma-separated Discord user IDs allowed to use the bot.
# If set, all other users are silently ignored (messages) or get an ephemeral error (slash commands).
# Right-click your username in Discord → Copy User ID (requires Developer Mode in Discord settings)
# Example: DISCORD_ALLOWED_USERS=123456789012345678
DISCORD_ALLOWED_USERS=

# Optional: comma-separated Discord user IDs allowed to invoke administrative
# slash actions (provider/model/effort changes, workspace/MCP/server operations,
# etc.). Public slash actions still follow DISCORD_ALLOWED_USERS. When empty,
# admin access falls back to DISCORD_ALLOWED_USERS (or everybody when both are empty).
# Example: DISCORD_ADMIN_USERS=123456789012345678
DISCORD_ADMIN_USERS=

# How non-image Discord attachments are sent to the agent:
#   native -> provider file attachment (default; the agent receives a file path)
#   text   -> inline as untrusted prompt text; attached code is never exposed as an executable file
# Images remain native vision context in either mode.
DISCORD_ATTACHMENT_MODE=native
# Maximum unique indexed Discord search candidates gathered across AI-generated queries
DISCORD_SEARCH_CANDIDATE_LIMIT=200
# Maximum semantically ranked Discord messages supplied to the answering agent
DISCORD_SEARCH_CONTEXT_LIMIT=50
# Maximum relevant durable memories injected into a response
DISCORD_MEMORY_RECALL_LIMIT=5

# ─── GitHub Copilot ──────────────────────────────────────────────────────────
# Use a token for a GitHub account with Copilot access. COPILOT_GITHUB_TOKEN is
# preferred; GH_TOKEN is also accepted. Without one, a persisted CLI login is used.
# COPILOT_GITHUB_TOKEN=github_pat_...
# GH_TOKEN=github_pat_...
# Progress update interval for long runs on every provider. Default: 60000 (1 minute).
# AI_PROGRESS_INTERVAL_MS=60000
# Maximum size and count of agent-created files attached to one Discord response.
# AI_OUTPUT_ATTACHMENT_MAX_BYTES=10485760
# AI_OUTPUT_ATTACHMENT_MAX_TOTAL_BYTES=10485760
# AI_OUTPUT_ATTACHMENT_MAX_COUNT=10
# Incoming uploads and URL downloads: default 100 MiB, maximum 512 MiB per file.
# AI_INPUT_ATTACHMENT_MAX_BYTES=104857600
# General/eBay browser reads use a separate memory-limited worker. The supplied
# Compose file configures this automatically; never expose the worker port publicly.
# AI_ASSISTANT_BROWSER_URL=http://browser:3123
# Software video conversion deadline: default 5 minutes, maximum 15 minutes.
# AI_MEDIA_TIMEOUT_MS=300000
# Time to wait for a provider to confirm cancellation. Default: 5000 (5 seconds).
# AI_CANCELLATION_GRACE_MS=5000
# Hard timeout in ms. The active Copilot run is explicitly aborted at this limit.
# Default: 3600000 (1 hour).
# COPILOT_TIMEOUT_MS=3600000
# Optional: default Copilot model. Default: claude-haiku-4.5
# COPILOT_MODEL=claude-opus-4.5

# ─── OpenAI Codex ────────────────────────────────────────────────────────────
# Optional when the Codex CLI is already logged in for the same user that runs the bot.
# OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible API endpoint override.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override the default Codex model (default: gpt-5.6-sol).
# CODEX_MODEL=gpt-5.6-sol
# Optional: default reasoning effort (minimal, low, medium, high, xhigh, max, ultra).
# CODEX_REASONING_EFFORT=low
# Hard timeout for Codex thread runs. Default: 3600000 (1 hour).
# CODEX_TIMEOUT_MS=3600000
# Hosted web search is separate from network access for local sandboxed commands.
# cached is recommended and is also the default when unset or blank.
# Modes: disabled, cached, indexed, live. Restart after changing this value.
CODEX_WEB_SEARCH_MODE=cached
# Optional: Codex config directory (default: ~/.codex) used for the model cache.
# CODEX_HOME=/path/to/codex

# ─── OpenCode ────────────────────────────────────────────────────────────────
# Requires: `opencode` CLI installed and `opencode auth login` configured.
# Provider API keys can also be supplied directly. OpenCode recognizes the
# environment variable for the selected provider; common examples include:
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Optional: override the default model in provider/model format.
# OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5
# Optional: override the opencode binary path (default: opencode from PATH).
# OPENCODE_BIN=/usr/local/bin/opencode
# Hard timeout for OpenCode runs. Default: 3600000 (1 hour).
# OPENCODE_TIMEOUT_MS=3600000

# ─── Provider security ───────────────────────────────────────────────────────
# shared: hardened multi-user mode. Provider credentials are isolated, external
# mutations are blocked, and provider file access is scoped to the workspace.
# Incoming DMs are disabled for everyone. /ask in servers requires an explicit
# DISCORD_ADMIN_USERS entry, a global bot-admin grant, or an ask.use rights grant.
# unrestricted: legacy behavior for private, trusted servers. Provider tools
# inherit the operator's full credentials, connected apps, and filesystem access.
# Existing installs where this variable is absent remain unrestricted for
# backwards compatibility; new installs should keep the safer shared default.
AI_ASSISTANT_SECURITY_MODE=shared
# Shared Codex shells can download npm packages from registry.npmjs.org.
# Stage builds in the session TMPDIR; see README's sandbox development workflow.
# The container sets this to /data/codex-tmp for executable private session scratch.
# Native installs default to the OS temporary directory; override if it is noexec.
# AI_ASSISTANT_CODEX_TMPDIR=/path/outside/the/workspace/codex-tmp
# Optional shared-mode exception for ChatGPT Sites (Codex only). When true,
# Discord users may create, update, and publish Sites as the logged-in ChatGPT
# account. This does not enable GitHub writes or other connected applications.
AI_ASSISTANT_ENABLE_SITES=false

# Optional server-side reviews of owned bot contribution PRs. Requires the
# GitHub contribution Apps, Linux, and the separate reviewer Compose profile.
# Reviews consume this worker's saved ChatGPT/Codex allowance; no API fallback.
AI_ASSISTANT_ENABLE_CODEX_REVIEWS=false
# Review attempts per PR, including failures, retained across turns/restarts.
# Default/unset/blank: 20; 0: unlimited. Non-negative safe integer.
# Apply the same value to the assistant and reviewer, then recreate both.
CODEX_REVIEW_LIMIT=20
# Reviewer-only settings; never taken from a Discord request or repository file.
# CODEX_REVIEW_MODEL=gpt-6-astra
# CODEX_REVIEW_REASONING_EFFORT=medium

# ─── Container ───────────────────────────────────────────────────────────────
# Directory available to provider file tools. The Docker deployment sets this
# to /data/workspaces so provider login/session state beside it is out of scope.
# Native installs may set this to a directory containing the repositories the
# bot is allowed to work on. Enforced only in shared security mode.
# AI_ASSISTANT_WORKSPACE_ROOT=/data/workspaces
# The container registers/updates guild slash commands before starting the bot.
# Set false to disable this after the first successful registration.
# REGISTER_COMMANDS_ON_START=true

# ─── Shared / MCP ────────────────────────────────────────────────────────────
# Optional: MCP server secrets for workspace .vscode/mcp.json ${input:xxx} values.
# Optional: explicit MCP configuration path. In Docker, use a path under /data.
# MCP_CONFIG_PATH=/data/mcp.json
# Format: MCP_INPUT_<ID_UPPERCASE> where hyphens become underscores.
# Example: MCP_INPUT_GRAFANA_SERVICE_ACCOUNT_TOKEN=your_token_here
# Example: MCP_INPUT_PORTAINER_API_TOKEN=your_token_here

# Optional named rights grants; see rights.example.json and README.
# Keep this operator-controlled file outside agent workspaces. Restart to reload.
# DISCORD_RIGHTS_FILE=/data/rights.json

# Scheduled channel messages and AI tasks (disabled until explicitly enabled).
# DISCORD_ADMIN_USERS or explicit bot-admin grants can create both task types.
# Delegate fixed messages with scheduler grants in DISCORD_RIGHTS_FILE.
SCHEDULES_ENABLED=false
SCHEDULE_MIN_INTERVAL_MINUTES=15
SCHEDULE_MAX_PER_USER=10
SCHEDULE_MAX_PER_GUILD=50
SCHEDULE_CONCURRENCY=2
SCHEDULE_AI_TIMEOUT_MS=600000
